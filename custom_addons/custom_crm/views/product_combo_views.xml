<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_crm_combo_tree" model="ir.ui.view">
        <field name="name">custom.crm.combo.tree</field>
        <field name="model">custom.crm.combo</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="combo_tier"/>
                <field name="component_product_ids" widget="many2many_tags"/>
                <field name="available_combo_count"/>
                <field name="min_order_total"/>
                <field name="max_order_total"/>
                <field name="state"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_custom_crm_combo_form" model="ir.ui.view">
        <field name="name">custom.crm.combo.form</field>
        <field name="model">custom.crm.combo</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="active" widget="boolean_button"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="combo_tier"/>
                            <field name="min_order_total"/>
                            <field name="max_order_total"/>
                            <field name="gift_value_limit"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="component_product_ids" widget="many2many_tags"/>
                            <field name="available_combo_count" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Serial phụ kiện trong kho">
                        <field name="component_serial_summary" readonly="1" nolabel="1"/>
                        <div class="text-muted">
                            Mỗi Serial chỉ được tính một lần; số combo khả dụng bằng số lượng nhỏ nhất của các phụ kiện.
                        </div>
                    </group>
                    <group string="Điều kiện quà tặng">
                        <field name="gift_value_limit"/>
                        <div class="text-muted">
                            Các phụ kiện được tặng sẽ tự thêm vào đơn bán với đơn giá 0.
                        </div>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_custom_crm_combo" model="ir.actions.act_window">
        <field name="name">Quản lý combo</field>
        <field name="res_model">custom.crm.combo</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_custom_crm_root" name="Quản lý sản phẩm"
              sequence="60" groups="stock.group_stock_user"/>
    <menuitem id="menu_custom_crm_combo" name="Quản lý combo"
              parent="menu_custom_crm_root" action="action_custom_crm_combo"
              sequence="10" groups="stock.group_stock_user"/>
</odoo>
