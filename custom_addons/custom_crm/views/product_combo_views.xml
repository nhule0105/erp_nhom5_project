<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_crm_combo_tree" model="ir.ui.view">
        <field name="name">custom.crm.combo.tree</field>
        <field name="model">custom.crm.combo</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="laptop_lot_id"/>
                <field name="mouse_lot_id"/>
                <field name="backpack_lot_id"/>
                <field name="state"/>
                <field name="assembled_date"/>
            </list>
        </field>
    </record>

    <record id="view_custom_crm_combo_form" model="ir.ui.view">
        <field name="name">custom.crm.combo.form</field>
        <field name="model">custom.crm.combo</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_combo" type="object" string="Gộp Combo"
                            class="oe_highlight" invisible="combo_product_id"/>
                    <button name="action_unbundle_combo" type="object" string="Tách Combo"
                            invisible="not combo_product_id or state == 'issued'"/>
                    <button name="action_mark_available" type="object" string="Đặt Sẵn sàng"
                            invisible="state == 'available'"/>
                    <button name="action_mark_issued" type="object" string="Đặt Đã xuất"
                            invisible="state == 'issued'"/>
                    <button name="action_mark_defective" type="object" string="Đặt Lỗi chờ xử lý"
                            invisible="state == 'defective'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,issued,defective"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="assembled_date"/>
                            <field name="state"/>
                            <field name="combo_product_id"/>
                        </group>
                        <group>
                            <field name="laptop_warranty_months"/>
                            <field name="mouse_warranty_months"/>
                            <field name="backpack_warranty_months"/>
                        </group>
                    </group>
                    <group string="S/N thành phần">
                        <field name="laptop_lot_id"/>
                        <field name="mouse_lot_id"/>
                        <field name="backpack_lot_id"/>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_custom_crm_combo" model="ir.actions.act_window">
        <field name="name">Combo nhập kho</field>
        <field name="res_model">custom.crm.combo</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_custom_crm_root" name="Quản lý sản phẩm"
              sequence="60" groups="stock.group_stock_user"/>
    <menuitem id="menu_custom_crm_combo" name="Combo nhập kho"
              parent="menu_custom_crm_root" action="action_custom_crm_combo"
              sequence="10" groups="stock.group_stock_user"/>
</odoo>
