<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_warranty_receipt" model="report.paperformat">
        <field name="name">Biên nhận hậu mãi A4 gọn</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_warranty_receipt_report" model="ir.actions.report">
        <field name="name">Biên nhận tiếp nhận thiết bị hậu mãi</field>
        <field name="model">warranty.ticket</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_warranty.warranty_receipt_document</field>
        <field name="report_file">custom_warranty.warranty_receipt_document</field>
        <field name="binding_model_id" ref="model_warranty_ticket"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_warranty_receipt"/>
        <field name="print_report_name">'Bien_nhan_tiep_nhan_%s' % (object.ticket_code)</field>
    </record>

    <template id="warranty_receipt_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="ticket">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <style>
                            .warranty-receipt,
                            .warranty-receipt * {
                                font-family: "DejaVu Sans", sans-serif !important;
                            }
                            .warranty-receipt table { width: 100%; }
                            .warranty-receipt th, .warranty-receipt td {
                                padding: 4px;
                                vertical-align: top;
                                overflow-wrap: anywhere;
                            }
                            .warranty-receipt h2 {
                                font-size: 20px;
                                margin: 0 0 4px;
                            }
                            .warranty-receipt .ticket-meta {
                                margin-bottom: 10px;
                            }
                            .warranty-receipt .section-title {
                                margin-top: 12px;
                                border-bottom: 1px solid #6c63a8;
                                padding-bottom: 3px;
                                font-size: 16px;
                            }
                            .warranty-receipt p {
                                margin-bottom: 8px;
                            }
                            .warranty-receipt .disclaimer {
                                margin-top: 8px;
                            }
                            .warranty-receipt .signatures { margin-top: 20px; }
                            .warranty-receipt .signature-space { height: 28mm; }
                            .warranty-receipt .signature-hint { margin-top: 2px; }
                            .warranty-receipt-footer {
                                border-top: 1px solid #222;
                                color: #777;
                                font-size: 10px;
                                padding-top: 4px;
                            }
                        </style>
                        <div class="warranty-receipt">
                        <h2 class="text-center">BIÊN NHẬN TIẾP NHẬN THIẾT BỊ HẬU MÃI</h2>
                        <p class="text-center ticket-meta">
                            Mã phiếu: <strong t-field="ticket.ticket_code"/>
                            <br/>
                            Loại yêu cầu: <strong t-field="ticket.ticket_type"/>
                        </p>

                        <h4 class="section-title">Khách hàng và thiết bị</h4>
                        <table class="table table-sm table-bordered">
                            <tbody>
                                <tr>
                                    <td><strong>Khách hàng</strong></td>
                                    <td>
                                        <span t-if="ticket.partner_id" t-field="ticket.partner_id"/>
                                        <span t-else="">Chưa xác định</span>
                                    </td>
                                    <td><strong>Số điện thoại</strong></td>
                                    <td>
                                        <span t-if="ticket.customer_phone" t-field="ticket.customer_phone"/>
                                        <span t-else="">Chưa có</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Sản phẩm</strong></td>
                                    <td><span t-field="ticket.product_id"/></td>
                                    <td><strong>Số serial</strong></td>
                                    <td><span t-field="ticket.serial_id"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Ngày tiếp nhận</strong></td>
                                    <td><span t-field="ticket.receive_date"/></td>
                                    <td><strong>Ngày mua</strong></td>
                                    <td>
                                        <span t-if="ticket.purchase_date" t-field="ticket.purchase_date"/>
                                        <span t-else="">Chưa có dữ liệu</span>
                                    </td>
                                </tr>
                                <t t-if="ticket.ticket_type == 'repair'">
                                    <tr>
                                        <td><strong>Tình trạng bảo hành</strong></td>
                                        <td><span t-field="ticket.warranty_status"/></td>
                                        <td><strong>Hạn bảo hành</strong></td>
                                        <td>
                                            <span t-if="ticket.warranty_end_date" t-field="ticket.warranty_end_date"/>
                                            <span t-else="">Chưa có dữ liệu</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Ngày hẹn trả</strong></td>
                                        <td colspan="3">
                                            <span t-if="ticket.promised_return_date" t-field="ticket.promised_return_date"/>
                                            <span t-else="">Chưa hẹn; cửa hàng sẽ thông báo cho khách hàng.</span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <h4 class="section-title">Tình trạng khi tiếp nhận</h4>
                        <table class="table table-sm table-bordered">
                            <tbody>
                                <tr>
                                    <td style="width: 25%;"><strong>Biểu hiện / lỗi khách báo</strong></td>
                                    <td>
                                        <span t-if="ticket.fault_summary" t-field="ticket.fault_summary"/>
                                        <span t-else="">Chưa ghi nhận</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Kiểm tra tình trạng</strong></td>
                                    <td><span t-field="ticket.intake_checklist_summary"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Ngoại quan / phụ kiện bàn giao</strong></td>
                                    <td>
                                        <div>
                                            <strong>Ngoại quan: </strong>
                                            <span t-if="ticket.condition_notes" t-field="ticket.condition_notes"/>
                                            <span t-else="">Chưa ghi nhận bất thường.</span>
                                        </div>
                                        <div>
                                            <strong>Phụ kiện: </strong>
                                            <span t-if="ticket.accessories_condition" t-field="ticket.accessories_condition"/>
                                            <span t-else="">Chưa ghi nhận.</span>
                                        </div>
                                    </td>
                                </tr>
                                <t t-if="ticket.intake_notes">
                                    <tr>
                                        <td><strong>Ghi chú khác</strong></td>
                                        <td><span t-field="ticket.intake_notes"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <p class="disclaimer">
                            Khách hàng xác nhận đã bàn giao thiết bị và các phụ kiện ghi trên biên nhận để cửa hàng
                            kiểm tra, xử lý theo yêu cầu. Biên nhận này xác nhận việc bàn giao, không phải kết luận
                            thiết bị đủ điều kiện bảo hành/đổi mới, kết quả sửa chữa hoặc khoản phí phải thanh toán.
                        </p>
                        <div class="row signatures">
                            <div class="col-6 text-center">
                                <strong>Khách hàng bàn giao</strong>
                                <div class="signature-hint"><em>(Ký và ghi rõ họ tên)</em></div>
                                <div class="signature-space"/>
                            </div>
                            <div class="col-6 text-center">
                                <strong>Nhân viên tiếp nhận</strong>
                                <div class="signature-hint"><em>(Ký và ghi rõ họ tên)</em></div>
                                <div class="signature-space"/>
                            </div>
                        </div>
                        </div>
                    </div>
                    <div class="footer warranty-receipt-footer">
                        Trang <span class="page"/> / <span class="topage"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
