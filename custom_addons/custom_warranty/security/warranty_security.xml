<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_warranty_technician" model="res.groups">
        <field name="name">Kỹ thuật viên bảo hành</field>
        <field name="category_id" ref="base.module_category_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_warranty_manager" model="res.groups">
        <field name="name">Quản lý bảo hành</field>
        <field name="category_id" ref="base.module_category_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_manager'))]"/>
    </record>

    <record id="rule_warranty_ticket_technician_assigned" model="ir.rule">
        <field name="name">Kỹ thuật viên chỉ xem phiếu được phân công</field>
        <field name="model_id" ref="model_warranty_ticket"/>
        <field name="groups" eval="[(4, ref('group_warranty_technician'))]"/>
        <field name="domain_force">[('technician_id', '=', user.id)]</field>
    </record>

    <record id="rule_warranty_ticket_manager_all" model="ir.rule">
        <field name="name">Quản lý bảo hành xem toàn bộ phiếu</field>
        <field name="model_id" ref="model_warranty_ticket"/>
        <field name="groups" eval="[(4, ref('group_warranty_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
