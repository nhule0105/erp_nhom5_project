<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_serial_numbers" model="ir.ui.view">
        <field name="name">sale.order.form.serial.numbers</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_customer_code" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="before">
                <group string="Combo khuyến mãi">
                    <field name="x_promotional_combo_id" readonly="1"/>
                    <field name="x_promotional_gift_product_ids"
                           widget="many2many_tags"
                           readonly="1"/>
                    <field name="x_promotional_combo_message" readonly="1" nolabel="1"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="is_combo_gift" optional="show" widget="boolean"/>
                <field name="x_combo_rule_id" optional="hide"/>
                <field name="x_selected_product_details"
                       string="Thông tin sản phẩm"
                       optional="show"
                       readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']"
                   position="after">
                <field name="x_selected_product_details" readonly="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Serial bán hàng" name="delivered_serials">
                    <div class="alert alert-info" role="alert">
                        Đơn bán chỉ hiển thị số lượng còn khả dụng.
                        Hãy quét/chọn đúng Serial thực tế trên phiếu giao.
                        Trạng thái chỉ chuyển sang Đã bán sau khi phiếu giao hoàn tất.
                    </div>
                    <field name="serial_lot_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="x_custom_status" widget="badge"/>
                            <field name="x_customer_id"/>
                            <field name="x_purchase_date"/>
                            <field name="x_warranty_start_date"/>
                            <field name="x_warranty_end_date"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_sale_shared_categories" model="ir.actions.act_window">
        <field name="name">Danh mục dùng chung Kho</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <delete id="menu_sale_shared_products" model="ir.ui.menu"/>
    <delete id="action_sale_shared_products" model="ir.actions.act_window"/>

    <menuitem id="menu_sale_shared_categories"
              name="Danh mục (Kho)"
              parent="sale.product_menu_catalog"
              action="action_sale_shared_categories"
              sequence="20"
              groups="base.group_no_one"/>
    <menuitem id="menu_sale_custom_combo"
              name="Quản lý Combo khuyến mãi"
              parent="sale.product_menu_catalog"
              action="custom_crm.action_custom_crm_combo"
              sequence="30"
              groups="base.group_no_one"/>
    <record id="menu_sale_shared_categories" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_no_one')])]"/>
    </record>
    <record id="menu_sale_custom_combo" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_no_one')])]"/>
    </record>

    <record id="view_sales_order_list_customer_code" model="ir.ui.view">
        <field name="name">sale.order.list.customer.code</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='partner_id']" position="after">
                <field name="x_customer_code" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_production_lot_form_sales_history" model="ir.ui.view">
        <field name="name">stock.production.lot.form.sales.history</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_group']/group[2]" position="inside">
                <group string="Lịch sử bán hàng">
                    <field name="x_custom_status" readonly="1"/>
                    <field name="x_customer_id" readonly="1"/>
                    <field name="x_sale_order_id" readonly="1"/>
                    <field name="x_sale_order_line_id" readonly="1"/>
                    <field name="x_sale_date" readonly="1"/>
                    <field name="x_purchase_date" readonly="1"/>
                    <field name="x_warranty_start_date" readonly="1"/>
                    <field name="x_warranty_end_date" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_production_lot_tree_sales_history" model="ir.ui.view">
        <field name="name">stock.production.lot.list.sales.history</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='product_id']" position="after">
                <field name="x_custom_status" optional="show" widget="badge"/>
                <field name="x_customer_id" optional="show"/>
                <field name="x_sale_order_id" optional="show"/>
                <field name="x_sale_date" optional="hide"/>
                <field name="x_warranty_start_date" optional="hide"/>
                <field name="x_warranty_end_date" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_form_sales_serials" model="ir.ui.view">
        <field name="name">stock.picking.form.sales.serials</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']" position="before">
                <div class="alert alert-info"
                     role="alert"
                     invisible="picking_type_code != 'outgoing'">
                    Quét/chọn đúng Serial thực tế còn trong kho cho từng sản phẩm
                    trước khi xác nhận giao hàng.
                </div>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='lot_ids']"
                   position="attributes">
                <attribute name="string">Quét S/N thực tế</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="options">{'no_create': True, 'no_quick_create': True}</attribute>
                <attribute name="domain">[('product_id', '=', product_id), ('product_qty', '&gt;', 0), ('x_custom_status', '=', 'available'), ('lifecycle_status', '=', 'available')]</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_sales_history" model="ir.ui.view">
        <field name="name">res.partner.form.sales.history</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Lịch sử mua hàng" name="custom_sales_history">
                    <field name="x_custom_sale_order_ids"
                           context="{'default_partner_id': id}"
                           readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="date_order"/>
                            <field name="x_customer_code"/>
                            <field name="user_id" optional="hide"/>
                            <field name="amount_untaxed" sum="Tạm tính"/>
                            <field name="amount_tax" sum="Thuế"/>
                            <field name="amount_total" sum="Tổng cộng"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
